    {"id":"req-live-stack","summary":"Real database broker and object storage preserve the order contract","component":"api-service","status":"satisfied"},
    {"id":"req-process-stack","summary":"Independent API worker collector and infrastructure processes complete and drain","component":"api-service","status":"satisfied"},
    {"id":"req-recovery","summary":"Provider faults schedules mutations and model differentials remain complete","component":"worker-service","status":"satisfied"},
    {"id":"req-load","summary":"The production-shaped stack stays within its bounded release load budget","component":"api-service","status":"satisfied"}
