    {"id":"check-process-stack","requirement":"req-process-stack","command":"process-conformance","expectation":"independent service processes complete duplicate-safe order processing and drain","status":"passed"},
    {"id":"check-recovery","requirement":"req-recovery","command":"fault-matrix","expectation":"all planned faults schedules differentials and mutations produce complete evidence","status":"passed"},
    {"id":"check-load","requirement":"req-load","command":"load-conformance","expectation":"the configured multi-order workload completes inside the declared regression budget","status":"passed"}
  ],
  "test_scenarios": [
    {"id":"local-contracts","label":"local service and domain contracts","requirement":"req-local-contracts","acceptance_check":"check-local-contracts","component":"api-service","command":"test","source_roots":["services/api","packages/shared","src","test"],"tags":["acceptance","deterministic"],"default_seed":1001,"fault_profile":"standard","required":true},
