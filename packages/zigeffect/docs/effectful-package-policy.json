    { "path": "packages/zigeffect-http/src/root.zig", "symbol": "pub const ServerService" },
    { "path": "packages/zigeffect-http/src/root.zig", "symbol": "pub fn serverLayer" },
    { "path": "packages/zigeffect-otel/src/root.zig", "symbol": "pub const ExporterService" },
    { "path": "packages/zigeffect-otel/src/root.zig", "symbol": "pub fn exporterLayer" },
