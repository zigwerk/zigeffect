{
  "schema": "zigeffect.effectful-package-policy.v2",
  "schema_version": 2,
  "canonical_source_paths": [
    "packages/zigeffect/src/kernel",
    "packages/zigeffect/src/statechart",
    "packages/zigeffect/src/workflow",
    "packages/zigeffect-std/src",
    "packages/zigeffect-cli/src",
    "packages/zigeffect-grpc/src",
    "packages/zigeffect-grpc/examples",
    "packages/zigeffect-http/src",
    "packages/zigeffect-http-tls-openssl/src",
    "packages/zigeffect-otel/src",
    "packages/zigeffect-parser/src",
    "packages/zigeffect-postgres/src",
    "packages/zigeffect-postgres-libpq/src",
    "packages/zigeffect-quic/src",
    "packages/zigeffect-redis/src",
    "packages/zigeffect-s3/src",
    "packages/zigeffect-storage-postgres/src",
    "packages/zigeffect-transport/src",
    "packages/zigeffect-zio/src",
    "packages/ziac/src",
    "packages/zgraphy/src",
    "packages/zigeffect-reference-system/services",
    "packages/zigeffect-reference-system/packages"
  ],
  "forbidden_regex": [
    "(const|var|pub const)[[:space:]]+EffectEnv\\b",
    "(pub[[:space:]]+)?fn[[:space:]]+LayerGraphEnv\\b",
    "(pub[[:space:]]+)?fn[[:space:]]+LayerWithError\\b",
    "layerGraph\\(",
    "Service\\.(Provider|ValueProvider)\\(",
    "(pub[[:space:]]+)?const[[:space:]]+GeneratedEffectServer\\b",
    "invokeEffect\\(",
    "ctx\\.runEffect\\("
  ],
  "application_paths": [
    "packages/ziac/src",
    "packages/zgraphy/src/main.zig",
    "packages/zigeffect-reference-system/services"
  ],
  "application_excluded_globs": [
    "!scaffold.zig"
  ],
  "application_exclusion_rationale": {
    "!scaffold.zig": "scaffold source contains negative policy text; rendered application sources have dedicated architecture tests"
  },
  "generated_application_template": {
    "path": "packages/zigeffect-cli/src/templates.zig",
    "start": "pub const production_wiring_source =",
    "end": "pub const production_test ="
  },
  "application_forbidden_regex": [
    "CausalStore\\.init",
    "attachBackend\\(",
    "storageBackend\\(",
    "fx\\.kernel\\.ManagedRuntime"
  ],
  "required_contracts": [
