# syntax=docker/dockerfile:1.7
FROM rust:1.88.0-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/tonic
COPY packages/zigeffect-grpc/benchmarks/tonic/Cargo.toml ./Cargo.toml
COPY packages/zigeffect-grpc/benchmarks/tonic/Cargo.lock ./Cargo.lock
COPY packages/zigeffect-grpc/benchmarks/tonic/build.rs ./build.rs
COPY packages/zigeffect-grpc/benchmarks/proto ../proto
COPY packages/zigeffect-grpc/benchmarks/tonic/src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --home /nonexistent --shell /usr/sbin/nologin nonroot
COPY --from=build --chown=65532:65532 /src/tonic/target/release/zigeffect-grpc-tonic-benchmark /server
USER 65532:65532
ENV PORT=8080
ENTRYPOINT ["/server"]
