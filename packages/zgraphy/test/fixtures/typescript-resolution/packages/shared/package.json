{
  "name": "@acme/shared",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./client": [
      "./missing.ts",
      { "types": "./src/client.ts", "import": "./src/client.ts" }
    ],
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.js"
    }
  }
}

