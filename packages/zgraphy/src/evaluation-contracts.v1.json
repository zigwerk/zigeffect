{
  "schema": "zgraphy.evaluation-contracts.v1",
  "schema_version": 1,
  "maturity": "contract_candidate",
  "definitions": [
    {
      "kind": "extraction",
      "receipt_schema": "zgraphy.differential-receipt.v1",
      "schema_version": 1,
      "evidence_state": "active_baseline",
      "unit": "fixture_engine_projection",
      "identity_fields": ["fixture_id","corpus_digest","source_revision","engine","adapter_version","provider_version","toolchain","configuration_digest"],
      "outcome_fields": ["input_counts","projection_summary","matched_ids","missing_ids","unexpected_ids","synthesized_ids","unmappable_values"],
      "metrics": ["entity_recall","relation_recall","fact_recall","hyperedge_recall","supernode_recall","conservative_precision","f1","evidence_line_match","provenance_match","projection_loss"],
      "failure_fields": ["unsupported_cases","parse_failures","projection_failures","omitted_units","truncation","limitations"],
      "promotion_requires": ["held_out_fixtures","complete_projection","source_evidence","quality_matrix","resource_matrix","no_unsupported_claims"],
      "controlled_arms_required": false,
      "correctness_required": true,
      "held_out_required": true,
      "unsupported_claims_forbidden": true
    },
    {
      "kind": "retrieval",
      "receipt_schema": "zgraphy.retrieval-receipt.v1",
      "schema_version": 1,
      "evidence_state": "schema_only",
      "unit": "held_out_query_task",
      "identity_fields": ["task_id","corpus_digest","source_revision","graph_generation","schema_digest","ontology_digest","index_digest","embedder_identity","query_plan_digest","configuration_digest"],
      "outcome_fields": ["intent","query","relevant_ids","returned_ids","proof_paths","evidence_refs","omitted_ids","truncated","bound_exhausted","unsupported_channels"],
      "metrics": ["exact_match","recall_at_k","mrr","ndcg","evidence_precision","proof_faithfulness","completeness","context_bytes","latency_ns"],
      "failure_fields": ["missing_relevant_ids","unsupported_channels","stale_dimensions","partial_dimensions","truncation","timeouts","limitations"],
      "promotion_requires": ["held_out_tasks","channel_ablations","complete_relevance_judgements","proof_validation","latency_budget","no_unsupported_claims"],
      "controlled_arms_required": true,
      "correctness_required": true,
      "held_out_required": true,
      "unsupported_claims_forbidden": true
    },
    {
      "kind": "agent_task",
      "receipt_schema": "zgraphy.agent-task-receipt.v1",
      "schema_version": 1,
      "evidence_state": "schema_only",
      "unit": "fixed_agent_task_trial",
      "identity_fields": ["task_id","corpus_digest","repository_revision","graph_generation","agent_identity","model_identity","prompt_digest","tool_policy_digest","arm","trial","configuration_digest"],
      "outcome_fields": ["rubric","success","assertions","evidence_citations","unsupported_claims","edits","tests","diagnostics","baseline_arm","assisted_arm"],
      "metrics": ["task_success","rubric_score","assertions_passed","unsupported_claims","edits","tests","tool_calls","file_reads","context_bytes","input_tokens","output_tokens","wall_time_ns","spend_microunits"],
      "failure_fields": ["unsupported_claims","missing_evidence","incorrect_edits","failed_tests","timeouts","tool_failures","truncation","limitations"],
      "promotion_requires": ["fixed_agent","baseline_arm","assisted_arm","held_out_tasks","declared_trials","complete_cost_accounting","task_evidence","no_unsupported_claims"],
      "controlled_arms_required": true,
      "correctness_required": true,
      "held_out_required": true,
      "unsupported_claims_forbidden": true
    },
    {
      "kind": "performance",
      "receipt_schema": "zgraphy.performance-receipt.v1",
      "schema_version": 1,
      "evidence_state": "schema_only",
      "unit": "identified_workload_sample_set",
      "identity_fields": ["workload_id","corpus_digest","source_revision","machine_digest","operating_system","target","toolchain","optimize","adapter_version","provider_version","configuration_digest"],
      "outcome_fields": ["warmups","repetitions","samples","aggregates","correctness_digest","comparison_eligible","limitations"],
      "metrics": ["latency_p50_ns","latency_p95_ns","latency_p99_ns","cpu_user_ns","cpu_system_ns","throughput_per_second","allocations","peak_rss_bytes","persisted_bytes"],
      "failure_fields": ["incorrect_projection","incomplete_samples","mixed_identity","process_exit","timeout","allocation_failure","truncation","limitations"],
      "promotion_requires": ["correctness_pass","retained_samples","paired_configuration","machine_identity","quality_matrix","resource_matrix","no_unsupported_claims"],
      "controlled_arms_required": true,
      "correctness_required": true,
      "held_out_required": false,
      "unsupported_claims_forbidden": true
    },
    {
      "kind": "resource",
      "receipt_schema": "zgraphy.resource-matrix.v1",
      "schema_version": 1,
      "evidence_state": "active_baseline",
      "unit": "paired_process_workload",
      "identity_fields": ["fixture_id","workload","engine","corpus_digest","source_revision","graphify_environment","machine_digest","configuration_digest","toolchain"],
      "outcome_fields": ["sampling","samples","aggregates","comparison_eligible","claims","limitations"],
      "metrics": ["elapsed_ns","cpu_user_ns","cpu_system_ns","peak_rss_bytes","persisted_bytes"],
      "failure_fields": ["incomplete_pairs","duplicate_samples","mixed_identity","process_exit","invalid_quantile","limitations"],
      "promotion_requires": ["paired_groups","minimum_repetitions","retained_integer_samples","complete_identity","quality_matrix","no_unsupported_claims"],
      "controlled_arms_required": true,
      "correctness_required": true,
      "held_out_required": false,
      "unsupported_claims_forbidden": true
    }
  ],
  "claim_policy": {
    "maturity": "baseline_only",
    "required_kinds": ["extraction","retrieval","agent_task","performance","resource"],
    "schema_only_eligible": false,
    "requires_held_out": true,
    "requires_paired_resources": true,
    "requires_complete_identity": true,
    "requires_non_cherry_picked_matrix": true,
    "requires_no_unsupported_claims": true
  }
}
